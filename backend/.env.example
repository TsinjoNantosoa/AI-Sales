APP_NAME=AI Sales Assistant API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DOCS_ENABLED=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/ai_sales
DATABASE_URL_SYNC=postgresql+psycopg://postgres:postgres@localhost:5433/ai_sales
REDIS_URL=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-to-a-long-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_ENABLED=true
# true = deterministic LangGraph fallback only (no OpenAI credits)
# false = OpenAI Responses API + automatic fallback on errors
AI_MOCK_MODE=true
AI_TEMPERATURE=0.2
AI_MAX_RETRIES=2
AI_TIMEOUT_SECONDS=30
AI_MAX_HISTORY_MESSAGES=20
AI_SUMMARY_ENABLED=true
AI_CONTEXT_MAX_CHARS=4000
# Optional: RUN_OPENAI_LIVE_TESTS=true to enable pytest live OpenAI smoke tests

N8N_BASE_URL=http://localhost:5678
N8N_PUBLIC_URL=
# Webhook URL exposed externally (use ngrok URL in dev when external services need to reach n8n)
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_API_KEY=
# Shared secret sent as X-N8N-Webhook-Key header — must be ≥16 chars
N8N_WEBHOOK_SECRET=dev-n8n-webhook-secret
N8N_ENABLED=false
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key-32-chars
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=n8n
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_PORT=5678
N8N_TIMEZONE=Europe/Paris
# Docker service-to-service URL (http://backend:8000 in Docker Compose, http://localhost:8000 outside)
BACKEND_INTERNAL_URL=http://backend:8000
# Required by the n8n workflow pack — allow $env access in Code/HTTP nodes (set in n8n container)
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/integrations/google/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/calendar.events

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@aisales.demo
SMTP_FROM_NAME=AI Sales Assistant
SMTP_USE_TLS=true

EMAIL_MOCK_MODE=true
GOOGLE_CALENDAR_MOCK_MODE=true

WEBHOOK_SIGNING_SECRET=dev-webhook-signing-secret
ENCRYPTION_KEY=dev-encryption-key-32-bytes-long!!
INTERNAL_API_KEY=dev-internal-api-key

RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute

LOG_LEVEL=INFO
SENTRY_DSN=

SEED_ON_STARTUP=false
