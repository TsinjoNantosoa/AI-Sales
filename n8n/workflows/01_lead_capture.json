    "05 Workflow Enabled?": {
      "main": [
        [{ "node": "06 Send Welcome", "type": "main", "index": 0 }],
        [{ "node": "10 Respond", "type": "main", "index": 0 }]
      ]
    },
    "06 Send Welcome": {
      "main": [[{ "node": "09 Mark Success", "type": "main", "index": 0 }]]
    },
    "09 Mark Success": {
