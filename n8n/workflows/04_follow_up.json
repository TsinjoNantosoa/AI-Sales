{
  "name": "AI Sales — Follow-up",
  "nodes": [
    {
      "parameters": {
        "content": "# Follow-up\nEvery 30 minutes, n8n asks FastAPI which leads are due. FastAPI owns the 24h / 3d / 7d rules and idempotency.\n\nWith `N8N_ENABLED=true`, this schedule replaces the ARQ follow-up cron.",
        "height": 300,
        "width": 580
      },
      "id": "681ddc7a-25e0-5345-a883-21ea6495310d",
      "name": "README — AI Sales — Follow-up",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -10,
        -80
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "f6ad760b-3fdf-5b61-a15c-c1935c28c0df",
      "name": "01 Schedule Every 30 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst bucket = new Date(now);\nbucket.setSeconds(0, 0);\nbucket.setMinutes(Math.floor(bucket.getMinutes() / 30) * 30);\nreturn [{ json: { runId: 'follow-up-schedule-' + bucket.toISOString(), startedAt: now.toISOString() } }];"
      },
      "id": "3e2af5cf-7104-5e93-a8ee-e6a5782ab72d",
      "name": "02 Create Run Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AI_SALES_BACKEND_URL || 'http://backend:8000' }}/api/v1/internal/n8n/executions/start",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflowSlug: 'follow-up', eventId: $json.runId, externalExecutionId: $execution.id, input: { runId: $json.runId, startedAt: $json.startedAt } }) }}"
      },
      "id": "ae14ac93-092e-5114-b8d6-c93260a657e7",
      "name": "03 Register Execution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "36843b2a-45d7-59f3-9b7a-70c700bfcebd",
              "leftValue": "={{ $json.duplicate }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c16b92d1-9cd6-5c06-a9f5-ff548a65e4ea",
      "name": "04 Duplicate Run?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "281633a3-eb5b-582f-9d33-484aefbfa3f8",
              "leftValue": "={{ $json.workflowEnabled }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "4aa86b8d-d8ac-5940-be20-8282cca4f646",
      "name": "05 Workflow Enabled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        920,
        360
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.AI_SALES_BACKEND_URL || 'http://backend:8000' }}/api/v1/internal/n8n/follow-ups/due",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "64e50491-6e6d-5586-8d4a-2be88035b564",
      "name": "06 Fetch Due Items",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1160,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const inputs = $input.all();\nconst rows = [];\nfor (const item of inputs) {\n  const j = item.json;\n  if (Array.isArray(j)) rows.push(...j);\n  else if (Array.isArray(j.data)) rows.push(...j.data);\n  else if (Array.isArray(j.body)) rows.push(...j.body);\n  else if (j && j.leadId) rows.push(j);\n}\nif (rows.length === 0) return [{ json: { hasWork: false } }];\nreturn rows.map((row, index) => ({ json: { ...row, hasWork: true }, pairedItem: { item: Math.min(index, Math.max(inputs.length - 1, 0)) } }));"
      },
      "id": "c0c78337-5790-5a8a-a31d-42529d4411ac",
      "name": "07 Normalize Due Leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1390,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "67d7e63b-0dab-5a69-92d5-322b344ca9e5",
              "leftValue": "={{ $json.hasWork }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ec0d8942-16dd-5592-a22f-29def9c87091",
      "name": "08 Has Work?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1620,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AI_SALES_BACKEND_URL || 'http://backend:8000' }}/api/v1/internal/n8n/follow-ups/{{ $json.leadId }}/execute",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ idempotencyKey: $json.idempotencyKey }) }}"
      },
      "id": "00f6edc4-f3e9-553a-abe5-350ef8095ab2",
      "name": "09 Execute Item",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1850,
