          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ externalExecutionId: $execution.id, output: { ok: true } }) }}"
      },
      "id": "317854f8-d48e-5a1e-b4f3-2c51829357b9",
      "name": "99 Mark Success",
      "type": "n8n-nodes-base.httpRequest",
