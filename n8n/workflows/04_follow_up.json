{
  "name": "AI Sales \u2014 Follow-up",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 30 }]
        }
      },
      "id": "0f2171ad-cc5d-4182-a4ea-efaaa09b3a1a",
      "name": "01 Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "jsCode": "const runId = `follow-up-schedule-${Date.now()}`;\nreturn [{ json: { runId, startedAt: new Date().toISOString() } }];"
      },
      "id": "n04-ctx",
      "name": "02 Create Run Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AI_SALES_BACKEND_URL || 'http://backend:8000' }}/api/v1/internal/n8n/executions/start",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Internal-Key", "value": "={{ $env.INTERNAL_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "options": { "timeout": 30000 },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflowSlug: 'follow-up', eventId: $json.runId, externalExecutionId: $execution.id, input: { runId: $json.runId, startedAt: $json.startedAt } }) }}"
      },
      "id": "n04-reg",
      "name": "03 Register Execution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.AI_SALES_BACKEND_URL || 'http://backend:8000' }}/api/v1/internal/n8n/follow-ups/due",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Internal-Key", "value": "={{ $env.INTERNAL_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "options": { "timeout": 30000 }
      },
      "id": "8a6c3da3-5309-4bef-9ed2-fd6924375ed5",
      "name": "04 Get Due Follow-ups",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AI_SALES_BACKEND_URL || 'http://backend:8000' }}/api/v1/internal/n8n/follow-ups/{{ $json.leadId }}/execute",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Internal-Key", "value": "={{ $env.INTERNAL_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "options": { "timeout": 30000 },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ idempotencyKey: $json.idempotencyKey }) }}"
      },
      "id": "ee96dbd5-2fbc-47fd-a774-9e43abe101d9",
      "name": "05 Execute Follow-up",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AI_SALES_BACKEND_URL || 'http://backend:8000' }}/api/v1/internal/n8n/executions/{{ $('03 Register Execution').item.json.executionId }}/success",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Internal-Key", "value": "={{ $env.INTERNAL_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "options": { "timeout": 30000 },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ output: { ok: true }, externalExecutionId: $execution.id }) }}"
      },
      "id": "n04-success",
      "name": "06 Mark Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 300]
    }
  ],
  "connections": {
    "01 Schedule": {
      "main": [[{ "node": "02 Create Run Context", "type": "main", "index": 0 }]]
    },
    "02 Create Run Context": {
      "main": [[{ "node": "03 Register Execution", "type": "main", "index": 0 }]]
    },
    "03 Register Execution": {
      "main": [[{ "node": "04 Get Due Follow-ups", "type": "main", "index": 0 }]]
    },
    "04 Get Due Follow-ups": {
      "main": [[{ "node": "05 Execute Follow-up", "type": "main", "index": 0 }]]
    },
    "05 Execute Follow-up": {
      "main": [[{ "node": "06 Mark Success", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": false },
  "tags": [{ "name": "ai-sales" }]
}
