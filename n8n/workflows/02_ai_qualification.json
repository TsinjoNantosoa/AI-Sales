            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ca9acd28-12c5-50e2-9615-9ee4152cf144",
              "leftValue": "={{ $json.__authOk }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "c75880e5-7e29-5626-878d-f4433be328e0",
      "name": "03 Authorized?",
      "type": "n8n-nodes-base.if",
