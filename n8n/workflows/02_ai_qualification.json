    {
      "parameters": {
        "jsCode": "const body = $input.item.json.body || $input.item.json;\nconst payload = body.payload || {};\nreturn [{\n  json: {\n    eventId: body.eventId || body.event_id,\n    eventType: body.eventType || body.event_type,\n    leadId: body.leadId || payload.leadId,\n    conversationId: body.conversationId || payload.conversationId,\n    correlationId: body.correlationId,\n    payload: payload,\n    requiresHuman: payload.requiresHuman === true,\n    becameHot: payload.becameHot === true,\n    score: payload.score,\n    temperature: payload.temperature\n  }\n}];"
      },
      "id": "n02-normalize",
      "name": "02 Normalize Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
