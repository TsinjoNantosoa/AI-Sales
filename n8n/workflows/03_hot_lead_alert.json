            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "5f443afe-8d3f-5940-8301-da8dc0bb25ba",
              "leftValue": "={{ $json.__authOk }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5585d2b1-fb03-5750-a3c7-51ff3d498637",
      "name": "03 Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
