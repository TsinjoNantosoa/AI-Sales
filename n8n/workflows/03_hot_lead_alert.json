    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst headers = item.headers || {};\nconst expected = $env.N8N_WEBHOOK_SECRET || '';\nconst provided = headers['x-n8n-webhook-key'] || headers['X-N8N-Webhook-Key'] || '';\nreturn [{ json: { ...item, __authOk: expected.length >= 16 && provided === expected } }];"
      },
      "id": "3426a77e-affa-5251-a878-a6a3974b9afa",
      "name": "02 Verify Webhook Secret",
      "type": "n8n-nodes-base.code",
