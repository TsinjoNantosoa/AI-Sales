{
  "name": "AI Sales \u2014 Meeting Reminder",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 30 }]
        }
      },
      "id": "0931e3ee-9593-460f-9672-b769c61ad4fd",
      "name": "01 Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "jsCode": "const runId = `meeting-reminder-${Date.now()}`;\nreturn [{ json: { runId, startedAt: new Date().toISOString() } }];"
      },
      "id": "n06-ctx",
      "name": "02 Create Run Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AI_SALES_BACKEND_URL || 'http://backend:8000' }}/api/v1/internal/n8n/executions/start",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Internal-Key", "value": "={{ $env.INTERNAL_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "options": { "timeout": 30000 },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflowSlug: 'meeting-reminder', eventId: $json.runId, externalExecutionId: $execution.id, input: { runId: $json.runId, startedAt: $json.startedAt } }) }}"
      },
      "id": "n06-reg",
      "name": "03 Register Execution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.AI_SALES_BACKEND_URL || 'http://backend:8000' }}/api/v1/internal/n8n/appointments/reminders/due",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Internal-Key", "value": "={{ $env.INTERNAL_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "options": { "timeout": 30000 }
      },
      "id": "2891f3df-e6c8-43d5-a388-a2cc6e505853",
      "name": "04 Get Due Reminders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AI_SALES_BACKEND_URL || 'http://backend:8000' }}/api/v1/internal/n8n/appointments/{{ $json.appointmentId }}/send-reminder",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Internal-Key", "value": "={{ $env.INTERNAL_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "options": { "timeout": 30000 },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ idempotencyKey: $json.idempotencyKey }) }}"
      },
      "id": "77f38c1f-075d-4289-8f76-01158666131d",
      "name": "05 Send Reminder",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AI_SALES_BACKEND_URL || 'http://backend:8000' }}/api/v1/internal/n8n/executions/{{ $('03 Register Execution').item.json.executionId }}/success",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "X-Internal-Key", "value": "={{ $env.INTERNAL_API_KEY }}" },
            { "name": "Content-Type", "value": "application/json" }
          ]
        },
        "options": { "timeout": 30000 },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ output: { ok: true }, externalExecutionId: $execution.id }) }}"
      },
      "id": "n06-success",
      "name": "06 Mark Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1300, 300]
    }
  ],
  "connections": {
    "01 Schedule": {
      "main": [[{ "node": "02 Create Run Context", "type": "main", "index": 0 }]]
    },
    "02 Create Run Context": {
      "main": [[{ "node": "03 Register Execution", "type": "main", "index": 0 }]]
    },
    "03 Register Execution": {
      "main": [[{ "node": "04 Get Due Reminders", "type": "main", "index": 0 }]]
    },
    "04 Get Due Reminders": {
      "main": [[{ "node": "05 Send Reminder", "type": "main", "index": 0 }]]
    },
    "05 Send Reminder": {
      "main": [[{ "node": "06 Mark Success", "type": "main", "index": 0 }]]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "meta": { "templateCredsSetupCompleted": false },
  "tags": [{ "name": "ai-sales" }]
}
