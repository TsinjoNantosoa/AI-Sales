{
  "name": "AI Sales — Meeting Reminder",
  "nodes": [
    {
      "parameters": {
        "content": "# Meeting Reminder\nPolls upcoming appointments and asks FastAPI to send each reminder exactly once.\n\nTimezone and appointment truth remain in the backend.",
        "height": 300,
        "width": 580
      },
      "id": "1c4611ae-179d-5254-9153-58bd97614eb8",
      "name": "README — AI Sales — Meeting Reminder",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -10,
        -80
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "b187ae21-22e1-5d9e-8b58-9d1ac6b55729",
      "name": "01 Schedule Every 30 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst bucket = new Date(now);\nbucket.setSeconds(0, 0);\nbucket.setMinutes(Math.floor(bucket.getMinutes() / 30) * 30);\nreturn [{ json: { runId: 'meeting-reminder-' + bucket.toISOString(), startedAt: now.toISOString() } }];"
      },
      "id": "ebd5c5c1-1e37-5f64-9728-de55661b665e",
      "name": "02 Create Run Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AI_SALES_BACKEND_URL || 'http://backend:8000' }}/api/v1/internal/n8n/executions/start",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflowSlug: 'meeting-reminder', eventId: $json.runId, externalExecutionId: $execution.id, input: { runId: $json.runId, startedAt: $json.startedAt } }) }}"
      },
      "id": "7accec44-fdea-540a-a602-92ceb586beb3",
      "name": "03 Register Execution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "b1608737-230f-5ad3-9405-fb0227bd6643",
              "leftValue": "={{ $json.duplicate }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "e0099c47-0359-5ddb-bee9-25401edd14f2",
      "name": "04 Duplicate Run?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "9941e15d-654b-51d2-a3b0-f50467655921",
              "leftValue": "={{ $json.workflowEnabled }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "3c8b44f6-dd57-5580-84e1-6320e51dd38a",
      "name": "05 Workflow Enabled?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        920,
        360
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.AI_SALES_BACKEND_URL || 'http://backend:8000' }}/api/v1/internal/n8n/appointments/reminders/due",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "7ec4426b-61f5-5efc-81f6-dd3d6c007066",
      "name": "06 Fetch Due Items",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1160,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "const inputs = $input.all();\nconst rows = [];\nfor (const item of inputs) {\n  const j = item.json;\n  if (Array.isArray(j)) rows.push(...j);\n  else if (Array.isArray(j.data)) rows.push(...j.data);\n  else if (Array.isArray(j.body)) rows.push(...j.body);\n  else if (j && j.appointmentId) rows.push(j);\n}\nif (rows.length === 0) return [{ json: { hasWork: false } }];\nreturn rows.map((row, index) => ({ json: { ...row, hasWork: true }, pairedItem: { item: Math.min(index, Math.max(inputs.length - 1, 0)) } }));"
      },
      "id": "c963d0cc-893a-5fb8-8351-18a1b446fd74",
      "name": "07 Normalize Due Appointments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1390,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "f55d16be-d8f9-5859-9ab9-5eaa79a4ca17",
              "leftValue": "={{ $json.hasWork }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0de488d4-3345-5529-b8ce-78c775df5295",
      "name": "08 Has Work?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1620,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AI_SALES_BACKEND_URL || 'http://backend:8000' }}/api/v1/internal/n8n/appointments/{{ $json.appointmentId }}/send-reminder",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ idempotencyKey: $json.idempotencyKey }) }}"
      },
      "id": "5ebf7d88-31b8-57b7-9b12-6fec8662bec0",
      "name": "09 Execute Item",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1850,
        220
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AI_SALES_BACKEND_URL || 'http://backend:8000' }}/api/v1/internal/n8n/executions/{{ $('03 Register Execution').item.json.executionId }}/success",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ JSON.stringify({ externalExecutionId: $execution.id, output: { ok: true } }) }"
      },
      "id": "d07d728a-36b5-5414-9576-189c3d253690",
      "name": "99 Mark Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2100,
        340
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "executeOnce": true
    }
  ],
