{
  "name": "AI Sales \u2014 Appointment Booking",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "appointment-created",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "c5bc4427-8af4-4a89-b93c-49a0ccf62d30",
      "name": "01 Webhook Appointment Created",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        200,
        300
      ],
      "webhookId": "de21d505-cbbc-4c80-9427-6f4bc005acff"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AI_SALES_BACKEND_URL || 'http://backend:8000' }}/api/v1/internal/n8n/executions/start",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ workflowSlug: 'appointment-booking', eventId: $json.body.eventId, leadId: $json.body.leadId, input: $json.body }) }}"
      },
      "id": "5ba49707-268d-4390-9052-f18ce56a5ba9",
      "name": "03 Register Execution",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        500,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_AI_SALES_INTERNAL_API",
          "name": "AI Sales Backend Internal API"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AI_SALES_BACKEND_URL || 'http://backend:8000' }}/api/v1/internal/n8n/appointments/{{ $json.body.appointmentId }}/booking-actions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ eventId: $json.body.eventId }) }}"
      },
      "id": "fbed3de4-a2cc-49ce-8858-11c2dfb9f2d0",
      "name": "06 Booking Actions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        740,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_AI_SALES_INTERNAL_API",
          "name": "AI Sales Backend Internal API"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AI_SALES_BACKEND_URL || 'http://backend:8000' }}/api/v1/internal/n8n/executions/{{ $('03 Register Execution').item.json.executionId }}/success",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Internal-Key",
              "value": "={{ $env.INTERNAL_API_KEY }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ output: $json }) }}"
      },
      "id": "485fd122-f810-44d1-b400-320746ccbd54",
      "name": "09 Mark Success",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        980,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CONFIGURE_AI_SALES_INTERNAL_API",
          "name": "AI Sales Backend Internal API"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: true, executionId: $json.executionId, duplicate: $json.duplicate } }}"
      },
      "id": "eb75adae-1803-457a-b212-4a1a39f92964",
      "name": "10 Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1220,
        300
      ]
    }
  ],
  "connections": {
    "01 Webhook Appointment Created": {
      "main": [
        [
          {
            "node": "03 Register Execution",
