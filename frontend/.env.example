# API Configuration
# Mode mock (défaut) : pas besoin du backend
VITE_USE_MOCKS=true
VITE_API_URL=http://localhost:8000/api/v1

# Pour brancher le backend FastAPI :
# VITE_USE_MOCKS=false
# VITE_API_URL=http://localhost:8000/api/v1

# App Configuration
VITE_APP_NAME=AI Sales Assistant
VITE_DEFAULT_LANGUAGE=en

# ⚠️ NEVER place API keys or secrets here.
# All secrets (OpenAI, Google OAuth, SMTP, n8n) must stay on the backend (FastAPI).
